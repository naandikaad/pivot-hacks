ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_TTS_API_KEY=...
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-5           # default - faster/cheaper; try claude-opus-5 for max quality
# TTS_PROVIDER=google                       # default - "google" (Cloud TTS) or "elevenlabs"
# GOOGLE_TTS_VOICE=en-US-Neural2-C          # default; try an en-US-Chirp3-HD-* voice for higher quality
# GOOGLE_TTS_LANGUAGE_CODE=en-US
# ELEVENLABS_API_KEY=...                    # only needed if TTS_PROVIDER=elevenlabs
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # default is the stock "Rachel" voice
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5     # default - lowest latency; eleven_turbo_v2_5 trades some speed for quality
# PORT=8787
